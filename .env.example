# Copy to .env.local and fill in what you have. Every value is optional:
# with no keys at all the app serves the checked-in fixture feed.
#
# Vite only exposes variables prefixed with VITE_, and it inlines them into the
# bundle at build time — so never put a secret that must stay private in here.

# --- News sources ----------------------------------------------------------
# https://newsapi.org/register
VITE_NEWSAPI_KEY=
VITE_NEWSAPI_BASE_URL=https://newsapi.org/v2

# https://open-platform.theguardian.com/access/
VITE_GUARDIAN_KEY=
VITE_GUARDIAN_BASE_URL=https://content.guardianapis.com/search

# https://developer.nytimes.com/get-started
VITE_NYT_KEY=
VITE_NYT_BASE_URL=https://api.nytimes.com/svc/search/v2/articlesearch.json

# Explicit provider allow-list, comma separated: newsapi,guardian,nyt,fixture
# Leave blank to use every provider whose key is set, or the fixture if none is.
VITE_NEWS_SOURCES=

# --- Feed behaviour --------------------------------------------------------
VITE_PAGE_SIZE=12
VITE_REQUEST_TIMEOUT_MS=8000

# --- Digest ----------------------------------------------------------------
# 'local' (default) runs the deterministic extractive summariser in the browser.
# 'remote' posts to VITE_SUMMARY_API_URL — an endpoint you host, which holds the
# model API key. Never put a model key in this file.
VITE_SUMMARY_PROVIDER=local
VITE_SUMMARY_API_URL=
VITE_SUMMARY_MODEL=claude-opus-5
