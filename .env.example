# Copy to .env.local for `npm run server`, or to .env for Docker Compose.
# These server variables never enter the Vite bundle.
NEWSAPI_KEY=
GUARDIAN_KEY=
NYT_KEY=
# Browser-visible source IDs only. Empty means the bundled fixture.
VITE_NEWS_SOURCES=
VITE_PAGE_SIZE=12
VITE_REQUEST_TIMEOUT_MS=8000
# local (default, offline) or remote; remote also needs VITE_SUMMARY_API_URL,
# an endpoint you host that holds the model key.
VITE_SUMMARY_PROVIDER=local
VITE_SUMMARY_API_URL=
VITE_SUMMARY_MODEL=
