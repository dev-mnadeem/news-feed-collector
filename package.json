{
  "name": "news-feed-collector",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-source news aggregator: pulls NewsAPI, The Guardian and the New York Times through one provider interface, normalises them into a single Article shape, and renders a filterable feed.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,server,tests}/**/*.{js,jsx,css}\" \"*.js\"",
    "format:check": "prettier --check \"{src,server,tests}/**/*.{js,jsx,css}\" \"*.js\"",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "test:server": "node --test server/*.test.js"
  },
  "dependencies": {
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
